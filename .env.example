# Optional: Google Gemini API Key for dynamic LLM analysis
# UnderstandGuard includes a zero-dependency deterministic Mock Mode (mock=true)
# that works completely out-of-the-box for demos and testing without an API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token to increase PR diff fetching rate limits (from 60 to 5,000 req/hr)
GITHUB_TOKEN=your_github_token_here
